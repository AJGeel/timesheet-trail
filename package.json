{
  "name": "better-history",
  "displayName": "Better History",
  "version": "0.1.0",
  "description": "A better browser history search, for time tracking.",
  "author": "Arthur Geel <ageel@enrise.com>",
  "scripts": {
    "dev": "BUILD_TARGET=firefox nodemon & bun load:firefox",
    "build": "BUILD_TARGET=chrome vite build && BUILD_TARGET=firefox vite build",
    "zip": "cd dist/firefox && zip -r firefox.zip . && mv firefox.zip ../firefox.zip && cd ../../ && cd dist/chromium && zip -r chromium.zip . && mv chromium.zip ../chromium.zip && cd ../../",
    "ship": "bun run build && bun zip",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.config.json",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "load:firefox": "web-ext run --source-dir dist/firefox",
    "store:auth": "ext-store auth",
    "store:status": "ext-store status",
    "store:submit": "ext-store submit",
    "tag-release": "ext-store tag-release"
  },
  "type": "module",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@ajgeel/ext-store": "0.1.3",
    "@types/bun": "1.3.14",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "web-ext": "^8.10.0"
  }
}
